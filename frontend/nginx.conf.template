worker_processes auto;

events {
  worker_connections 1024;
}

http {
  include mime.types;
  default_type application/octet-stream;

  sendfile on;
  keepalive_timeout 65;
  server_tokens off;

  client_max_body_size 20m;

  # gzip 压缩 (text/html 默认已包含, 此处补齐其余文本类资源)
  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_types text/css text/plain text/javascript application/javascript application/json application/xml image/svg+xml;

  server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html index.htm;

    # CSP 只写一次, 各 location 经变量引用 (location 内出现任何 add_header 都不再继承 server 级头, 需重复声明)
    # connect-src 放行 api.iconify.design: SvgIcon 的 iconify 图标运行时从该 API 拉取数据
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.iconify.design; worker-src 'self' blob:; frame-src https://quote.eastmoney.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'";

    # ---- 安全响应头 ----
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy $csp always;

    # SPA 入口: HTML 永不缓存 (内容哈希资源才配长缓存), 未命中路由回退 index.html
    location / {
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Frame-Options "DENY" always;
      add_header Referrer-Policy "strict-origin-when-cross-origin" always;
      add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
      add_header Content-Security-Policy $csp always;
      add_header Cache-Control "no-cache" always;
      try_files $uri $uri/ /index.html;
    }

    # vite 构建产物文件名带内容哈希, 可永久缓存
    location /assets/ {
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Frame-Options "DENY" always;
      add_header Referrer-Policy "strict-origin-when-cross-origin" always;
      add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
      add_header Content-Security-Policy $csp always;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /health {
      access_log off;
      return 200 'OK';
      add_header Content-Type text/plain;
    }

    # 后端 API (含 SSE 流式对话: HTTP/1.1 长连接 + 关闭响应缓冲, 否则事件会被 nginx 攒批导致卡顿)
    # upstream 用变量 + resolver: proxy_pass 静态主机名只在启动时解析一次 Docker DNS,
    # backend 容器重建后 IP 变化会导致 nginx 持续打到旧地址 (间歇性 502/前端超时);
    # 127.0.0.11 是 Docker 内置 DNS, valid=10s 每 10 秒重新解析
    location ^~/api/ {
      resolver 127.0.0.11 valid=10s ipv6=off;
      set $backend_upstream ${BACKEND_URL};
      proxy_pass $backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 300;
      proxy_send_timeout 300;
      proxy_read_timeout 300;
      proxy_buffering off;
      proxy_ssl_server_name on;
    }

    location ^~/auth/ {
      resolver 127.0.0.11 valid=10s ipv6=off;
      set $backend_upstream ${BACKEND_URL};
      proxy_pass $backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 300;
      proxy_send_timeout 300;
      proxy_read_timeout 300;
      proxy_buffering off;
      proxy_ssl_server_name on;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
      root html;
    }
  }
}
